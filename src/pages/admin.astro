---
import Base from '../layouts/Base.astro';
---
<Base title="Admin Dashboard | Careerconnect NG" description="Private vacancy management dashboard."><section class="wrap admin"><div class="section-head"><div><p class="eyebrow blue">CAREERCONNECT NG</p><h1>Vacancy dashboard</h1><p>Add, edit, publish or import job listings.</p></div><a href="/">← View website</a></div><div id="setup" class="warning" hidden>Supabase is not configured. Follow README.md to create a Supabase project and add environment variables.</div><section id="login" class="panel"><h2>Administrator sign in</h2><form id="login-form"><label>Email<input id="email" type="email" required autocomplete="username"></label><label>Password<input id="password" type="password" required autocomplete="current-password"></label><button class="btn">Sign in</button><p id="login-msg" aria-live="polite"></p></form></section><div id="dashboard" hidden><div class="stats"><div class="panel">Total jobs <b id="total">0</b></div><div class="panel">Published <b id="published">0</b></div><div class="panel">Drafts <b id="drafts">0</b></div></div><div class="admin-grid"><section class="panel"><h2 id="form-title">Add a vacancy</h2><form id="job-form"><input id="id" type="hidden"><div class="formrow"><label>Job title *<input id="title" required></label><label>Company *<input id="company" required></label></div><div class="formrow"><label>Location *<input id="location" required></label><label>Category *<input id="category" required></label></div><div class="formrow"><label>Employment type<select id="type"><option>Full-time</option><option>Part-time</option><option>Contract</option><option>Internship</option><option>Remote</option></select></label><label>Experience level<select id="experience"><option>Entry level</option><option>Graduate trainee</option><option>Junior</option><option>Mid-level</option><option>Senior</option><option>Any level</option></select></label></div><div class="formrow"><label>Salary<input id="salary" placeholder="Optional"></label><label>Deadline<input id="deadline" type="date"></label></div><label>Description *<textarea id="description" required rows="4"></textarea></label><label>Responsibilities (one per line)<textarea id="responsibilities" rows="3"></textarea></label><label>Requirements (one per line)<textarea id="requirements" rows="3"></textarea></label><label>Official application URL *<input id="url" type="url" required placeholder="https://..."></label><div class="formrow"><label>Status<select id="status"><option value="draft">Draft</option><option value="published">Published</option></select></label><label class="check"><input id="featured" type="checkbox"> Feature this job</label></div><button class="btn">Save vacancy</button> <button id="clear" class="outline" type="button">Clear</button><p id="job-msg" aria-live="polite"></p></form></section><section class="panel"><h2>Bulk import CSV</h2><p>Download the template, fill it with verified jobs, then upload it here.</p><a href="/jobs-template.csv" download>Download CSV template ↗</a><form id="csv-form"><label>CSV file<input id="csv" type="file" accept=".csv,text/csv" required></label><label class="check"><input id="csv-publish" type="checkbox"> Publish imported jobs immediately</label><button class="btn">Import CSV</button><p id="csv-msg" aria-live="polite"></p></form><hr><button id="refresh" class="outline" type="button">Refresh listings</button><button id="logout" class="outline" type="button">Sign out</button></section></div><section class="panel"><h2>Manage vacancies</h2><div id="listing">Loading…</div></section></div><p class="disclaimer">Admin access is enforced through Supabase authentication and row-level security. Never share your admin password.</p></section><script>import '../scripts/admin.js';</script></Base>
