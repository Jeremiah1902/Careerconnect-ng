---
import Base from '../../layouts/Base.astro';import {jobBySlug,dateLabel} from '../../data/jobs.js';export const prerender=false;
const job=Astro.params.slug?await jobBySlug(Astro.params.slug):null;
const title=job?`${job.title} at ${job.company} | Careerconnect NG`:'Vacancy not found | Careerconnect NG';
const desc=job?`${job.title} at ${job.company} in ${job.location}. View requirements, deadline and application details.`:'This vacancy is not available.';
const data=job?{'@context':'https://schema.org','@type':'JobPosting',title:job.title,description:[job.description,job.responsibilities,job.requirements].filter(Boolean).join('\n\n'),datePosted:job.posted_at,validThrough:job.deadline?`${job.deadline}T23:59:00+01:00`:undefined,employmentType:job.employment_type?.toUpperCase().replaceAll(' ','_'),hiringOrganization:{'@type':'Organization',name:job.company},jobLocation:{'@type':'Place',address:{'@type':'PostalAddress',addressLocality:job.location,addressCountry:'NG'}},directApply:true}:null;
---
<Base title={title} description={desc}>
{job?<><script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g,'\\u003c')}/><section class="detail-hero"><div class="wrap"><a href="/#jobs">← Back to all jobs</a><div class="detail-title"><div class="company-logo large">{job.company.slice(0,2).toUpperCase()}</div><div><p class="eyebrow">{job.category}</p><h1>{job.title}</h1><p>{job.company} · {job.location}</p></div></div><div class="pills"><span>{job.employment_type}</span><span>{job.experience_level}</span></div></div></section><section class="wrap detail"><article><h2>About this role</h2>{(job.description||'Description not provided.').split(/\n+/).map(s=><p>{s}</p>)}{job.responsibilities&&<><h2>Responsibilities</h2>{job.responsibilities.split(/\n+/).map(s=><p>✓ {s}</p>)}</>}{job.requirements&&<><h2>Requirements</h2>{job.requirements.split(/\n+/).map(s=><p>✓ {s}</p>)}</>}<aside class="safety"><b>Apply with care</b><p>Verify the employer and application destination. Never pay a recruiter to secure a job or share sensitive account details.</p></aside></article><aside class="apply"><p class="eyebrow blue">JOB OVERVIEW</p>{[['Location',job.location],['Job type',job.employment_type],['Experience',job.experience_level],['Salary',job.salary||'Not stated'],['Deadline',dateLabel(job.deadline)]].map(([k,v])=><div><span>{k}</span><b>{v||'Not stated'}</b></div>)}<a class="btn" href={job.application_url} target="_blank" rel="noopener noreferrer">Apply on official site ↗</a><button id="share" class="outline">Share vacancy</button><p id="feedback"></p></aside></section></>:<section class="wrap notfound"><h1>Vacancy not available</h1><p>It may have expired or the link may be incorrect.</p><a class="btn" href="/#jobs">Browse vacancies</a></section>}
<script>document.querySelector('#share')?.addEventListener('click',async()=>{try{if(navigator.share)await navigator.share({title:document.title,url:location.href});else{await navigator.clipboard.writeText(location.href);document.querySelector('#feedback').textContent='Link copied.'}}catch(e){}})</script>
</Base>
