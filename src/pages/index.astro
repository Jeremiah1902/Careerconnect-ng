---
import Base from '../layouts/Base.astro';import {jobs,dateLabel} from '../data/jobs.js';const list=await jobs();
const cats=['Graduate Trainee','Information Technology','Accounting & Finance','Administration','Sales & Marketing','Engineering'];
---
<Base>
<section class="hero"><div class="wrap hero-grid"><div><p class="eyebrow">✦ YOUR NEXT OPPORTUNITY STARTS HERE</p><h1>Find work that<br><span>moves you forward.</span></h1><p class="intro">Explore opportunities across Nigeria. Review the details and apply through the employer's official channel.</p><a class="btn" href="#jobs">Explore jobs ↗</a><a class="hero-link" href="#categories">Browse categories →</a><p class="trust">✓ Clear job details · Direct application links</p></div><div class="feature"><span class="tiny">CAREER SPOTLIGHT ✦</span><div class="orb">CC</div><p class="tiny">CAREERCONNECT PICKS</p><h2>Make your next move.</h2><p>Explore roles that match your skills, goals and experience.</p><div class="pills"><span>Graduate roles</span><span>Tech</span><span>Finance</span></div><a href="#jobs" class="feature-link">Find your opportunity ↗</a></div></div>
<div class="wrap search"><form id="search"><label>⌕ <span>KEYWORD<input id="keyword" placeholder="Job title, company or keyword"></span></label><label>⌖ <span>LOCATION<input id="location" placeholder="e.g. Lagos, Abuja"></span></label><button class="btn">Search jobs →</button></form></div></section>
<section id="categories" class="wrap section"><div class="section-head"><div><p class="eyebrow blue">EXPLORE YOUR PATH</p><h2>Browse by category</h2><p>Start with the area that fits your career direction.</p></div><a href="#jobs">See all jobs →</a></div><div class="categories">{cats.map((c,i)=><button data-cat={c}><span>{['✦','⌘','↗','▤','◎','⌁'][i]}</span>{c}<b>↗</b></button>)}</div></section>
<section id="jobs" class="job-section"><div class="wrap"><div class="section-head"><div><p class="eyebrow blue">YOUR NEXT CHAPTER</p><h2>Latest opportunities</h2><p>Useful details to help you decide where to apply.</p></div><span class="count"><i></i><b id="count">{list.length}</b> listed opportunities</span></div><div class="filters"><select id="category"><option value="">All categories</option>{[...new Set([...list.map(j=>j.category),...cats])].map(c=><option>{c}</option>)}</select><select id="type"><option value="">All job types</option>{['Full-time','Part-time','Contract','Internship','Remote'].map(t=><option>{t}</option>)}</select><span>Check vacancy details before applying.</span></div><div class="jobs" id="jobs-grid">{list.map(j=><article class="job" data-title={j.title.toLowerCase()} data-company={j.company.toLowerCase()} data-location={j.location.toLowerCase()} data-category={j.category} data-type={j.employment_type}><div class="jobtop"><span>{j.category}</span>{j.featured&&<b>✦ Featured</b>}</div><div class="jobtitle"><div class="company-logo">{j.company.slice(0,2).toUpperCase()}</div><div><h3><a href={`/jobs/${j.slug}`}>{j.title}</a></h3><p>{j.company}</p></div></div><div class="meta"><span>⌖ {j.location}</span><span>◷ {j.employment_type}</span></div><div class="jobbottom"><span>Deadline: {dateLabel(j.deadline)}</span><a href={`/jobs/${j.slug}`} aria-label={`View ${j.title}`}>↗</a></div></article>)}</div><p id="empty" hidden>No matching vacancies. Try another search.</p><p class="demo-note">Sample listings are demonstrations, not real vacancies. Replace them with verified opportunities before promoting the site.</p></div></section>
<section class="wrap how"><div><p class="eyebrow blue">SIMPLE BY DESIGN</p><h2>Your next opportunity,<br>in three steps.</h2><p>Spend less time searching and more time preparing.</p></div><div class="steps"><article><b>01</b><div><h3>Discover</h3><p>Search by role, location or category.</p></div></article><article><b>02</b><div><h3>Review</h3><p>Read the requirements, responsibilities and deadline.</p></div></article><article><b>03</b><div><h3>Apply</h3><p>Use the official application link in the listing.</p></div></article></div></section>
<section class="cta"><div class="wrap"><div><p class="eyebrow">STAY OPPORTUNITY-READY</p><h2>Your next chapter could start today.</h2><p>Bookmark Careerconnect NG and check back for new opportunities.</p></div><a class="btn white" href="#jobs">Browse vacancies ↗</a></div></section>
<script>
const cards=[...document.querySelectorAll('.job')],$=id=>document.getElementById(id);
function filter(){let q=$('keyword').value.toLowerCase().trim(),loc=$('location').value.toLowerCase().trim(),cat=$('category').value,type=$('type').value,n=0;cards.forEach(c=>{let ok=(!q||`${c.dataset.title} ${c.dataset.company} ${c.dataset.category}`.includes(q))&&(!loc||c.dataset.location.includes(loc))&&(!cat||c.dataset.category===cat)&&(!type||c.dataset.type===type);c.hidden=!ok;if(ok)n++});$('count').textContent=n;$('empty').hidden=n>0}
$('search').addEventListener('submit',e=>{e.preventDefault();filter();$('jobs').scrollIntoView({behavior:'smooth'})});['keyword','location','category','type'].forEach(id=>$(id).addEventListener('input',filter));document.querySelectorAll('[data-cat]').forEach(b=>b.addEventListener('click',()=>{let option=[...$('category').options].find(o=>o.value.toLowerCase()===b.dataset.cat.toLowerCase());$('category').value=option?option.value:'';filter();$('jobs').scrollIntoView({behavior:'smooth'})}));
</script>
</Base>
